page {
  background: #f5f7fa;
  color: #333;
}
.container {
  padding: 30rpx;
}
.form-header {
  width: 95%;
  margin-bottom: 40rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
}
.page-hint {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 10rpx;
  display: block;
  line-height: 1.4;
}
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #34495e;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #f1f2f6;
  padding-bottom: 16rpx;
}
.section-title .icon {
  margin-right: 14rpx;
  font-size: 36rpx;
}
.picker-box {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #2c3e50;
}
.input-group {
  margin-bottom: 20rpx;
}
.input-group .label {
  font-size: 26rpx;
  color: #7f8c8d;
  display: block;
  margin-bottom: 10rpx;
}
.input-group input {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 180rpx;
}
.long-textarea {
  height: 320rpx;
  line-height: 1.5;
}
.placeholder-style {
  color: #a0aec0;
  font-size: 26rpx;
}
.submit-btn {
  background: #3b82f6;
  color: #fff;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 40rpx;
  padding: 24rpx 0;
  margin-top: 50rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 8rpx 20rpx rgba(59,130,246,0.3);
}
.submit-btn:active {
  background: #2563eb;
  transform: scale(0.99);
}