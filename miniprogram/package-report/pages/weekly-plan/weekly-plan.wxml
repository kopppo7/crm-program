<view class="container">
  <view class="form-header">
    <text class="page-title">{{currentLang === 'zh' ? '本周工作计划' : 'แผนงานประจำสัปดาห์นี้'}}</text>
    <text class="page-hint">{{currentLang === 'zh' ? '请严格按照要求填写本周的各项核心量化指标' : 'โปรดกรอกตัวชี้วัดหลักประจำสัปดาห์ตามข้อกำหนดอย่างเคร่งครัด'}}</text>
  </view>

  <form bindsubmit="submitForm" style="width: 100%;">
    <view class="form-section">
      <view class="section-title">
        <text class="icon">📅</text>
        <text>{{currentLang === 'zh' ? '当前计划周期' : 'รอบแผนงานปัจจุบัน'}}</text>
      </view>
      <view class="picker-box readonly-box">
        <text style="color: #3b82f6; font-weight: bold;">{{weekRange}}</text>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text class="icon">🎯</text>
        <text>{{currentLang === 'zh' ? '核心量化目标' : 'เป้าหมายเชิงปริมาณหลัก'}}</text>
      </view>

      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '1. 计划完成2分钟以上有效通话 (个)' : '1. จำนวนสายที่คุยเกิน 2 นาที (คน)'}}</text>
        <input name="planCalls" type="number" placeholder="{{currentLang === 'zh' ? '请输入目标数量...' : 'โปรดระบุจำนวนเป้าหมาย...'}}" placeholder-class="placeholder-style" />
      </view>

      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '2. 计划新增 Line OA 好友人数 (人)' : '2. จำนวนเพื่อนใหม่ใน Line OA (คน)'}}</text>
        <input name="planLine" type="number" placeholder="{{currentLang === 'zh' ? '请输入目标数量...' : 'โปรดระบุจำนวนเป้าหมาย...'}}" placeholder-class="placeholder-style" />
      </view>

      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '3. 计划邀约到店看车客户数量 (个)' : '3. จำนวนลูกค้าที่เชิญมาดูรถที่ร้าน (คน)'}}</text>
        <input name="planVisit" type="number" placeholder="{{currentLang === 'zh' ? '请输入目标数量...' : 'โปรดระบุจำนวนเป้าหมาย...'}}" placeholder-class="placeholder-style" />
      </view>

      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '4. 计划邀约视频看车客户数量 (个)' : '4. จำนวนลูกค้าที่เชิญดูรถผ่านวิดีโอ (คน)'}}</text>
        <input name="planVideo" type="number" placeholder="{{currentLang === 'zh' ? '请输入目标数量...' : 'โปรดระบุจำนวนเป้าหมาย...'}}" placeholder-class="placeholder-style" />
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text class="icon">📝</text>
        <text>{{currentLang === 'zh' ? '5. 其他工作安排' : '5. การจัดการงานอื่นๆ'}}</text>
      </view>
      <textarea name="planOther" class="form-textarea" placeholder="{{currentLang === 'zh' ? '请填写本周其他的日常或统筹工作安排...' : 'โปรดระบุแผนงานทั่วไปหรือการจัดการงานอื่นๆ ในสัปดาห์นี้...'}}" maxlength="-1"></textarea>
    </view>

    <button class="submit-btn" form-type="submit">{{currentLang === 'zh' ? '确认提交计划' : 'ยืนยันการส่งแผนงาน'}}</button>
  </form>
</view>