/* 全局页面底色 */
.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 30rpx 24rpx 120rpx 24rpx;
  box-sizing: border-box;
}

/* 优雅阴影卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(153, 163, 174, 0.08);
  margin-bottom: 40rpx;
}

/* 表单单项 */
.form-item {
  margin-bottom: 32rpx;
}

.no-border {
  margin-bottom: 40rpx;
}

/* 标签行 */
.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.required {
  color: #ef4444;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 6rpx;
}

.label {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

/* 输入框统一精致样式 */
.input-box {
  width: 100%;
  height: 88rpx;
  background-color: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

/* 输入框聚焦效果 */
.input-box:focus {
  background-color: #ffffff;
  border-color: #10b981;
  box-shadow: 0 0 12rpx rgba(16, 185, 129, 0.08);
}

/* 文本域统一样式 */
.textarea-box {
  width: 100%;
  height: 160rpx;
  background-color: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
}

.placeholder-style {
  color: #9ca3af;
  font-size: 28rpx;
}

/* 单选框（Radio）布局优化 */
.radio-group {
  display: flex;
  gap: 50rpx;
  padding: 10rpx 0;
}

.radio-label {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #f3f4f6;
  border-radius: 50rpx;
  transition: all 0.2s;
}

.radio-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

/* 底部绿色立体按钮 */
.footer-btn {
  margin-top: 48rpx;
  padding: 0 10rpx;
}

.submit-btn {
  width: 100% !important;
  height: 96rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 48rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  transition: all 0.2s ease;
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.2);
  opacity: 0.9;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}