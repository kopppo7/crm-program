page { 
  background: #f5f7fa; 
}
.container { 
  padding: 40rpx 30rpx; 
}
.header { 
  margin-bottom: 50rpx; 
  width: 95%;
}
.title { 
  font-size: 44rpx; 
  font-weight: bold; 
  color: #333; 
  display: block; 
}
.subtitle { 
  font-size: 28rpx; 
  color: #888; 
  margin-top: 12rpx; 
  display: block; 
}
.report-card { 
  background: #fff; 
  border-radius: 20rpx; 
  padding: 30rpx; 
  display: flex; 
  align-items: center; 
  margin-bottom: 30rpx; 
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); 
}
.report-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}
.icon-wrap { 
  width: 90rpx; 
  height: 90rpx; 
  border-radius: 24rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 44rpx; 
  margin-right: 30rpx; 
}
.weekly-bg { background: #e0f2fe; } /* 浅蓝色背景 */
.daily-bg { background: #fef3c7; }  /* 浅黄色背景 */
.text-wrap { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
}
.card-title { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #333; 
  margin-bottom: 10rpx; 
}
.card-desc { 
  font-size: 24rpx; 
  color: #888; 
  line-height: 1.4;
}
.arrow { 
  font-size: 36rpx; 
  color: #ccc; 
  font-weight: bold; 
}
.card-list {
  width: 95%;
}