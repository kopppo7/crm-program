page {
  background: #f4f6f9;
}
.container {
  padding: 30rpx;
}

.header-card {
  width: 95%;
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.header-card .icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.header-card .date-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.detail-content {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  min-height: 400rpx;
  width: 95%;
}

.text-block {
  font-size: 30rpx;
  color: #475569;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}