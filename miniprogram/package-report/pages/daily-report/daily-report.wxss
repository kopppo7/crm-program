page {
  background: #f5f7fa;
  color: #333;
}
.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.form-header {
  width: 100%;
  margin-bottom: 40rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
}
.page-hint {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 10rpx;
  display: block;
  line-height: 1.4;
}
/* 模块卡片 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  width: 100%;
  box-sizing: border-box;
  /* 增加展开时的平滑渐入动画 */
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #34495e;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #f1f2f6;
  padding-bottom: 16rpx;
}
.section-title .icon {
  margin-right: 14rpx;
  font-size: 36rpx;
}
.picker-box {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: bold;
}
/* 禁用的日期选择框样式 */
.readonly-box {
  background: #f1f2f6 !important; 
  color: #7f8c8d !important;      
  border-color: #e2e8f0 !important;
}

.input-group {
  margin-bottom: 24rpx;
}
.input-group:last-child {
  margin-bottom: 0;
}
.input-group .label {
  font-size: 26rpx;
  color: #7f8c8d;
  display: block;
  margin-bottom: 12rpx;
}
.input-group input {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 200rpx;
  line-height: 1.5;
}
.placeholder-style {
  color: #a0aec0;
  font-size: 26rpx;
}
.submit-btn {
  background: #10b981; 
  color: #fff;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 40rpx;
  padding: 24rpx 0;
  margin-top: 50rpx;
  margin-bottom: 80rpx;
  box-shadow: 0 8rpx 20rpx rgba(16,185,129,0.3);
  width: 100%;
}
.submit-btn:active {
  background: #059669;
  transform: scale(0.99);
}

/* 🌟 结构化列表样式 */
.client-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.client-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.item-info {
  flex: 1;
}
.item-title {
  font-size: 28rpx;
  margin-bottom: 6rpx;
}
.c-name {
  font-weight: bold;
  color: #1f2937;
  margin-right: 12rpx;
}
.c-phone {
  color: #3b82f6;
  font-family: monospace;
}
.item-desc {
  font-size: 24rpx;
  color: #64748b;
}
.item-actions {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}
.btn-edit { color: #10b981; }
.btn-del { color: #ef4444; }

.add-btn {
  background: #f8fafc; /* 更淡的背景色 */
  color: #5a83bc; /* 柔和的浅灰蓝色文字 */
  text-align: center;
  padding: 16rpx 0; /* 高度稍微收敛一点 */
  border-radius: 12rpx;
  font-size: 26rpx; /* 字号稍微调小 */
  font-weight: normal; /* 去掉加粗，降低视觉比重 */
  border: 1px dashed #d7e9ff; /* 更浅的虚线边框 */
  margin-top: 10rpx; /* 距离上面的列表拉开一点点间距 */
}

/* 🌟 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
}
.modal-content {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background: #fff;
  border-radius: 20rpx;
  z-index: 1000;
  overflow: hidden;
}
.modal-header {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}
.modal-body {
  padding: 30rpx;
}
.m-input-group {
  margin-bottom: 24rpx;
}
.m-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 10rpx;
}
.m-input, .m-picker {
  width: 100%;
  box-sizing: border-box;
  background: #f1f5f9;
  border-radius: 10rpx;
  /* padding: 18rpx 24rpx; */
  font-size: 28rpx;
}
.modal-footer {
  display: flex;
  border-top: 1px solid #e2e8f0;
}
.m-btn-cancel, .m-btn-confirm {
  flex: 1;
  background: transparent;
  font-size: 30rpx;
  padding: 26rpx 0;
  border-radius: 0;
}
.m-btn-cancel::after, .m-btn-confirm::after { border: none; }
.m-btn-cancel { color: #64748b; border-right: 1px solid #e2e8f0; }
.m-btn-confirm { color: #10b981; font-weight: bold; }

