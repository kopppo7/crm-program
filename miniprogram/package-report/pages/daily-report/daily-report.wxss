page {
  background: #f5f7fa;
  color: #333;
}
.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.form-header {
  width: 100%;
  margin-bottom: 40rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
}
.page-hint {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 10rpx;
  display: block;
  line-height: 1.4;
}
/* 模块卡片 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  width: 100%;
  box-sizing: border-box;
  /* 增加展开时的平滑渐入动画 */
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #34495e;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #f1f2f6;
  padding-bottom: 16rpx;
}
.section-title .icon {
  margin-right: 14rpx;
  font-size: 36rpx;
}
.picker-box {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: bold;
}
/* 禁用的日期选择框样式 */
.readonly-box {
  background: #f1f2f6 !important; 
  color: #7f8c8d !important;      
  border-color: #e2e8f0 !important;
}

.input-group {
  margin-bottom: 24rpx;
}
.input-group:last-child {
  margin-bottom: 0;
}
.input-group .label {
  font-size: 26rpx;
  color: #7f8c8d;
  display: block;
  margin-bottom: 12rpx;
}
.input-group input {
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8f9fa;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 200rpx;
  line-height: 1.5;
}
.placeholder-style {
  color: #a0aec0;
  font-size: 26rpx;
}
.submit-btn {
  background: #10b981; 
  color: #fff;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 40rpx;
  padding: 24rpx 0;
  margin-top: 50rpx;
  margin-bottom: 80rpx;
  box-shadow: 0 8rpx 20rpx rgba(16,185,129,0.3);
  width: 100%;
}
.submit-btn:active {
  background: #059669;
  transform: scale(0.99);
}