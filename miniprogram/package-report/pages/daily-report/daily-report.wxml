<view class="container">
  <view class="form-header">
    <text class="page-title">{{currentLang === 'zh' ? '每日工作汇报' : 'รายงานการทำงานประจำวัน'}}</text>
    <text class="page-hint">{{currentLang === 'zh' ? '请如实填写今日销售数据与客户跟进详细进展' : 'โปรดกรอกข้อมูลยอดขายประจำวันและความคืบหน้าในการติดตามลูกค้าตามความเป็นจริง'}}</text>
  </view>

  <form bindsubmit="submitForm" style="width: 100%;">
    <view class="form-section">
      <view class="section-title">
        <text class="icon">📅</text>
        <text>{{currentLang === 'zh' ? '汇报日期' : 'วันที่รายงาน'}}</text>
      </view>
      <view class="picker-box readonly-box">
        <text>{{reportDate}}</text>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text class="icon">🔢</text>
        <text>{{currentLang === 'zh' ? '今日核心数据' : 'ข้อมูลหลักประจำวัน'}}</text>
      </view>
      
      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '今日处理新客户数量 (个)' : 'จำนวนลูกค้าใหม่ที่จัดการวันนี้ (คน)'}}</text>
        <input name="countNew" type="number" placeholder="{{currentLang === 'zh' ? '如：5' : 'เช่น: 5'}}" placeholder-class="placeholder-style" bindinput="onCountInput" data-type="countNew" />
      </view>
      
      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '今日跟进老客户数量 (个)' : 'จำนวนลูกค้าเก่าที่ติดตามวันนี้ (คน)'}}</text>
        <input name="countFollow" type="number" placeholder="{{currentLang === 'zh' ? '如：15' : 'เช่น: 15'}}" placeholder-class="placeholder-style" bindinput="onCountInput" data-type="countFollow" />
      </view>
      
      <view class="input-group">
        <text class="label">{{currentLang === 'zh' ? '自主拓展客户数量 (个)' : 'จำนวนลูกค้าที่หาเพิ่มด้วยตนเอง (คน)'}}</text>
        <input name="countSelf" type="number" placeholder="{{currentLang === 'zh' ? '如：3' : 'เช่น: 3'}}" placeholder-class="placeholder-style" bindinput="onCountInput" data-type="countSelf" />
      </view>
    </view>

    <view class="form-section" wx:if="{{countNew > 0}}">
      <view class="section-title">
        <text class="icon">🆕</text>
        <text>{{currentLang === 'zh' ? '新客户具体情况说明' : 'รายละเอียดเกี่ยวกับลูกค้าใหม่'}}</text>
      </view>
      <textarea name="detailNew" class="form-textarea" placeholder="{{currentLang === 'zh' ? '请说明今天系统分配的新客户对接情况，购机意向如何，是否有加过Line...' : 'โปรดระบุรายละเอียดความคืบหน้าของลูกค้าใหม่ในวันนี้...'}}" maxlength="-1"></textarea>
    </view>

    <view class="form-section" wx:if="{{countFollow > 0}}">
      <view class="section-title">
        <text class="icon">🔄</text>
        <text>{{currentLang === 'zh' ? '跟进客户进展说明' : 'รายละเอียดการติดตามลูกค้าเก่า'}}</text>
      </view>
      <textarea name="detailFollow" class="form-textarea" placeholder="{{currentLang === 'zh' ? '请说明今天联系的老客户或高意向客户，比如某客户还在考虑价格、某客户需要协助折扣等...' : 'โปรดระบุรายละเอียดของลูกค้าเก่าที่ติดต่อในวันนี้...'}}" maxlength="-1"></textarea>
    </view>

    <view class="form-section" wx:if="{{countSelf > 0}}">
      <view class="section-title">
        <text class="icon">🚀</text>
        <text>{{currentLang === 'zh' ? '自主拓展客户说明' : 'รายละเอียดลูกค้าที่หาเพิ่มเอง'}}</text>
      </view>
      <textarea name="detailSelf" class="form-textarea" placeholder="{{currentLang === 'zh' ? '请说明今天通过跑市场、农田拜访或者社交媒体自己挖掘到的新客户详情...' : 'โปรดระบุรายละเอียดลูกค้าใหม่ที่คุณหาได้เอง...'}}" maxlength="-1"></textarea>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text class="icon">📝</text>
        <text>{{currentLang === 'zh' ? '其他日常工作说明' : 'คำอธิบายงานอื่นๆ'}}</text>
      </view>
      <textarea name="detailOther" class="form-textarea" placeholder="{{currentLang === 'zh' ? '例如：参加培训会议、整理报表、处理售后问题等...' : 'เช่น: เข้าร่วมการประชุม, จัดทำรายงาน, จัดการปัญหาหลังการขาย...'}}" maxlength="-1"></textarea>
    </view>

    <button class="submit-btn" form-type="submit">{{currentLang === 'zh' ? '确认并提交日报' : 'ยืนยันการส่งรายงานประจำวัน'}}</button>
  </form>
</view>