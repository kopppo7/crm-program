page { background: #f4f6f9; color: #333; height: 100%; }
.container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 优雅顶栏 Tab */
.tab-header { display: flex; background: #fff; border-bottom: 2rpx solid #e5e7eb; width: 95%; }
.tab-item { flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx; color: #6b7280; font-weight: 500; position: relative; }
.tab-item.active { color: #3b82f6; font-weight: bold; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 30%; right: 30%; height: 6rpx; background: #3b82f6; border-radius: 4rpx; }

/* 简洁筛选栏 */
.filter-bar { display: flex; background: #fff; padding: 16rpx 30rpx; border-bottom: 2rpx solid #f3f4f6; gap: 20rpx; }
.filter-cell { background: #f3f4f6; padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; color: #4b5563; display: flex; align-items: center; }
.filter-cell .icon { margin-right: 8rpx; }

/* 滚动列表 */
.list-scroll { flex: 1; padding: 20rpx 30rpx; box-sizing: border-box; }

/* 数据卡片设计 */
.report-card { background: #fff; border-radius: 16rpx; padding: 26rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02); border-left: 8rpx solid #3b82f6; }
.daily-card { border-left-color: #10b981; }
.weekly-card { border-left-color: #3b82f6; }

.card-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.sales-name { font-size: 32rpx; font-weight: bold; color: #1f2937; }
.report-date, .week-tag { font-size: 26rpx; color: #6b7280; }

/* 徽章行 */
.badge-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.badge-item { padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 500; }
.badge-item .num { font-weight: bold; }
.bg-blue { background: #e0f2fe; color: #0369a1; }
.bg-orange { background: #ffedd5; color: #c2410c; }
.bg-green { background: #dcfce7; color: #15803d; }
.bg-purple { background: #f3e8ff; color: #6b21a8; }

/* 详情内容块 */
.content-box { background: #f9fafb; border-radius: 8rpx; padding: 16rpx; margin-top: 14rpx; display: flex; flex-direction: column; }
.content-label { font-size: 24rpx; font-weight: bold; color: #4b5563; margin-bottom: 6rpx; }
.content-text { font-size: 26rpx; color: #1f2937; line-height: 1.5; white-space: pre-wrap; }

/* 空提示 */
.empty-tip { text-align: center; padding-top: 150rpx; color: #9ca3af; display: flex; flex-direction: column; align-items: center; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

