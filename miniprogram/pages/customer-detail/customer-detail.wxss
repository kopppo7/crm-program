page {
  background-color: #f4f6f9;
  padding-bottom: 100px; /* 适配底部双按钮悬浮区 */
}

.container {
  padding: 15px 0; /* 左右边距由内部卡片的 margin 控制 */
}

/* ================= 1. 紧凑型基础信息卡片 ================= *//* ================= 1. 基础信息卡片 (单列布局) ================= */
.customer-info-card {
  width: 85%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin: 0 30rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #eeeeee;
}

.info-header .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  background: #e6f7ff;
  color: #1890ff;
  font-weight: bold;
}

/* 核心修改：改回单列垂直排列 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 控制每一行之间的间距 */
}

.info-item {
  display: flex;
  align-items: flex-start; /* 确保长文本换行时，左侧标签依然在顶部对齐 */
  font-size: 28rpx;
  line-height: 1.5;
}

.info-item .label {
  color: #888888;
  margin-right: 16rpx;
  white-space: nowrap; /* 保证左侧的标签不被折行 */
  flex-shrink: 0; /* 保证标签不被右侧长文本挤压变形 */
}

.info-item .value {
  color: #333333;
  font-weight: 500;
  flex: 1; /* 值占满右侧所有剩余空间 */
  word-break: break-all; /* 支持超长泰文/英文换行 */
}

.info-item .highlight {
  color: #07c160;
  font-weight: bold;
}

/* ================= 2. 客户画像模块 (支持折叠) ================= */
.profile-card {
  width: 85%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 0 30rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  transition: all 0.3s ease;
}

.profile-header.collapsed {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.title-box {
  display: flex;
  flex-direction: column;
}

.profile-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.profile-header .desc {
  font-size: 22rpx;
  color: #888888;
  margin-top: 6rpx;
}

.header-action {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.edit-btn {
  background-color: #f0f9eb;
  color: #07c160;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #c2e7b0;
}

.toggle-text {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}

.highlight-text {
  color: #07c160 !important;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-item {
  display: flex;
  flex-direction: column;
}

.profile-item .label {
  font-size: 26rpx;
  font-weight: bold;
  color: #555555;
  margin-bottom: 6rpx;
}

.profile-item .sub-label {
  font-size: 22rpx;
  font-weight: normal;
  color: #999999;
}

.profile-item .value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
}

.profile-item .value.unknown {
  color: #ff4d4f;
  font-weight: bold;
}

/* ================= 3. 时间轴区域 ================= */
.timeline-section {
  width: 85%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #07c160;
  padding-left: 16rpx;
}

.empty-logs {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.timeline-item {
  display: flex;
  margin-bottom: 40rpx;
}

.line-box {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #07c160;
  border: 6rpx solid #e1f5e8;
  z-index: 2;
}

.line {
  flex: 1;
  width: 4rpx;
  background: #eeeeee;
  margin-top: 8rpx;
  margin-bottom: -48rpx;
}

.timeline-item:last-child .line {
  display: none;
}

.log-content {
  flex: 1;
  background: #fcfcfc;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
}

.log-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.log-date {
  font-size: 24rpx;
  color: #999999;
}

.log-type {
  font-size: 24rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.log-tag {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.log-note {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.log-reason {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #fff1f0;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.log-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.log-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #eeeeee;
}

/* ================= 4. 底部固定按钮组 ================= */
.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 60rpx; /* 适配全面屏底部安全区 */
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.reassign-picker {
  flex: 1;
}

.reassign-btn {
  background: #f5f7fa !important;
  color: #606266 !important;
  font-size: 28rpx !important;
  font-weight: bold;
  border-radius: 48rpx;
  height: 88rpx;
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
  padding: 0 !important;
}

.reassign-btn::after {
  border: none !important;
}

.reassign-btn:active {
  background: #eef1f6 !important;
  opacity: 0.8;
}

.follow-btn {
  flex: 1.6;
  background: #07c160 !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: bold;
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

.follow-btn::after {
  border: none !important;
}

.follow-btn:active {
  transform: scale(0.97);
  background: #06ad56 !important;
}

/* ================= 5. 编辑画像底部弹窗 ================= */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.modal-header {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.modal-scroll {
  padding: 30rpx;
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  background-color: #f7f7f7;
  height: 80rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 40rpx;
  border-top: 1rpx solid #eeeeee;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background-color: #f5f5f5;
  color: #666666;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save {
  flex: 2;
  background-color: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ================= 🌟 录音展示区样式 ================= */
.log-audio-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0; /* 添加一条虚线分割，更有层次感 */
}

.no-audio {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
}

.no-audio .icon {
  margin-right: 8rpx;
}

.audio-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.audio-item {
  display: flex;
  align-items: center;
  background-color: #f1f5f9;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  border: 1px solid #e2e8f0;
}

.audio-item:active {
  background-color: #e2e8f0; /* 点击反馈 */
}

.audio-item .icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.audio-item .audio-name {
  flex: 1;
  font-size: 24rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-item .download-text {
  font-size: 22rpx;
  color: #0284c7;
  margin-left: 20rpx;
  font-weight: bold;
}