<view class="container">
  <view class="todo-tabs">
    <view class="todo-tab {{activeTab === 'all_todo' ? 'active' : ''}}" bindtap="switchTab" data-tab="all_todo">
      {{currentLang === 'zh' ? '常规待办' : 'งานทั่วไป'}}
    </view>
    <view class="todo-tab {{activeTab === 'no_answer' ? 'active' : ''}}" bindtap="switchTab" data-tab="no_answer">
      {{currentLang === 'zh' ? '未接电话' : 'ไม่รับสาย'}}
      <view class="tab-badge" wx:if="{{noAnswerCount > 0}}">{{noAnswerCount}}</view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-box">
      <icon type="search" size="14" color="#999" />
      <input class="search-input" placeholder="{{t.searchPlaceholder}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" value="{{searchKeyword}}" />
      <icon wx:if="{{searchKeyword}}" type="clear" size="14" color="#ccc" bindtap="clearSearch" style="padding: 10px;" />
    </view>
  </view>

  <scroll-view class="list-container" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{customerList.length === 0 && !isLoading}}" class="empty-state">
      <text>{{searchKeyword ? (currentLang === 'zh' ? '没有找到' : 'ไม่พบข้อมูล') : t.emptyTodo}}</text>
    </view>

    <view class="customer-card" wx:for="{{customerList}}" wx:key="_id">
      <view class="card-content" bindtap="goToDetail" data-id="{{item._id}}" style="{{item.is_key_customer ? 'border-right: 10rpx solid #f59e0b; background: linear-gradient(to right, #ffffff 60%, #fffbeb 100%);' : ''}}">
        
        <view class="header">
          <!-- 名字容器，防挤压 -->
          <view class="name-box">
            <text wx:if="{{item.is_key_customer}}" class="key-star">⭐</text>
            <text class="name">{{item.name}}</text>
          </view>
          
          <view class="tags-container">
            <text wx:if="{{item.isOverdue && item.status !== 'Closed Won' && item.status !== 'Closed Lost' && item.status !== 'Invalid'}}" class="tag tag-overdue">{{currentLang === 'zh' ? '已逾期' : 'เลยกำหนด'}}</text>
            <text wx:if="{{item.status === 'pending' || !item.status}}" class="tag tag-pending">{{localizedStatusMap['pending'] || (currentLang === 'zh' ? '待处理' : 'รอดำเนินการ')}}</text>
            <text wx:if="{{item.status === 'No Answer'}}" class="tag tag-warning">{{localizedStatusMap['No Answer'] || (currentLang === 'zh' ? '未接通' : 'ไม่รับสาย')}}</text>
            <text wx:if="{{item.status === 'Busy'}}" class="tag tag-busy">{{localizedStatusMap['Busy'] || (currentLang === 'zh' ? '忙碌' : 'ไม่สะดวก')}}</text>
            <text wx:if="{{item.status !== 'pending' && item.status !== 'No Answer' && item.status !== 'Busy' && item.status !== 'Closed Won' && item.status !== 'Closed Lost' && item.status !== 'Invalid' && item.status}}" class="tag tag-following">{{localizedStatusMap[item.status] || item.status}}</text>
            <text wx:if="{{item.status === 'Closed Won' || item.status === 'Closed Lost' || item.status === 'Invalid'}}" class="tag tag-closed">{{localizedStatusMap[item.status] || item.status}}</text>
          </view>
        </view>

        <view class="phone-row">
          <text
            class="phone-link"
            catchtap="makePhoneCall"
            data-phone="{{item.phone}}"
            data-status="{{item.status}}"
            data-last-call-ts="{{item.lastCallTimestamp || 0}}"
          >
            📞 {{item.phone}}
          </text>
        </view>

        <view wx:if="{{item.status === 'No Answer'}}" class="last-call-row">
          <text class="last-call-label">
            {{currentLang === 'zh' ? '上次拨打' : 'โทรล่าสุด'}}
          </text>
          <text class="last-call-time">
            {{item.lastCallDisplay || (currentLang === 'zh' ? '暂无记录' : 'ไม่มีข้อมูล')}}
          </text>
        </view>

        <!-- 需求与备注限制单行，超出省略，保持绝对紧凑 -->
        <view class="info text-gray">
          {{t.lblPayload || '需求机型'}}: {{item.payload && item.payload !== 'none' ? item.payload : '--'}} |
          {{t.lblCity || '城市'}}: {{item.city && item.city !== 'none' ? item.city : '--'}}
          <block wx:if="{{item.remark && item.remark !== 'none' && item.remark !== 'undefined'}}">
            | {{t.lblRemark || '备注'}}: {{item.remark}}
          </block>
        </view>

        <!-- 🌟 重组：紧凑扁平的元数据底栏 -->
        <view class="card-bottom-bar">
          <view class="bottom-item">
            <text class="bottom-icon">⏰</text>
            <text class="text-highlight">{{item.todoDisplayDate}}</text>
          </view>
        </view>

      </view>
    </view>
    <view class="loading-bottom" wx:if="{{customerList.length > 0}}">
      <text>{{isLoading ? t.loading : (hasMore ? t.loadMore : t.noMore)}}</text>
    </view>
  </scroll-view>
</view>