<view class="container">
  
  <!-- 🌟 新增：专属待办分类 Tab (仅在进入“今日待办”时显示) -->
  <view class="todo-tabs" wx:if="{{currentType === 'todo'}}">
    <view class="todo-tab {{activeTab === 'all_todo' ? 'active' : ''}}" bindtap="switchTab" data-tab="all_todo">
      {{currentLang === 'zh' ? '常规待办' : 'งานทั่วไป'}}
    </view>
    <view class="todo-tab {{activeTab === 'no_answer' ? 'active' : ''}}" bindtap="switchTab" data-tab="no_answer">
      {{currentLang === 'zh' ? '未接电话' : 'ไม่รับสาย'}}
      <!-- 醒目的未接电话红点 -->
      <view class="tab-badge" wx:if="{{noAnswerCount > 0}}">{{noAnswerCount}}</view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-box">
      <icon type="search" size="14" color="#999" />
      <input 
        class="search-input" 
        placeholder="{{t.searchPlaceholder}}" 
        bindinput="onSearchInput" 
        bindconfirm="onSearch" 
        confirm-type="search" 
        value="{{searchKeyword}}"
      />
      <icon wx:if="{{searchKeyword}}" type="clear" size="14" color="#ccc" bindtap="clearSearch" style="padding: 10px;" />
    </view>
  </view>

  <scroll-view class="list-container" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{customerList.length === 0 && !isLoading}}" class="empty-state">
      <text>{{searchKeyword ? (currentLang === 'zh' ? '没有找到' : 'ไม่พบข้อมูล') : (currentType === 'todo' ? t.emptyTodo : t.emptyData)}}</text>
    </view>

    <view class="customer-card" wx:for="{{customerList}}" wx:key="_id">
      <view class="card-content" bindtap="goToDetail" data-id="{{item._id}}">
        
        <view class="header">
          <text class="name">{{item.name}}</text>
          
          <view class="tags-container">
            <text wx:if="{{item.isOverdue && item.status !== 'Closed Won' && item.status !== 'Closed Lost' && item.status !== 'Invalid'}}" class="tag tag-overdue">{{currentLang === 'zh' ? '已逾期' : 'เลยกำหนด'}}</text>
            
            <text wx:if="{{item.status === 'pending' || !item.status}}" class="tag tag-pending">{{currentLang === 'zh' ? '待处理' : 'รอดำเนินการ'}}</text>
            
            <text wx:if="{{item.status === 'No Answer'}}" class="tag tag-warning">{{currentLang === 'zh' ? '未接通(需重拨)' : 'ไม่รับสาย(โทรซ้ำ)'}}</text>
            
            <text wx:if="{{item.status !== 'pending' && item.status !== 'No Answer' && item.status !== 'Closed Won' && item.status !== 'Closed Lost' && item.status !== 'Invalid' && item.status}}" class="tag tag-following">{{currentLang === 'zh' ? '再次跟进' : 'ติดตามอีกครั้ง'}}</text>
            
            <text wx:if="{{item.status === 'Closed Won' || item.status === 'Closed Lost' || item.status === 'Invalid'}}" class="tag tag-closed">{{statusMap[item.status] || item.status}}</text>

            <text wx:if="{{item.status === 'Busy'}}" class="tag tag-busy">{{currentLang === 'zh' ? '不方便接电话' : 'ไม่สะดวกรับสาย'}}</text>
          </view>
        </view>
        
        <view class="info phone-row">
          <text>📞 </text>
          <text class="phone-link" catchtap="makePhoneCall" data-phone="{{item.phone}}">{{item.phone}}</text>
        </view>
        
        <view class="info text-gray">{{t.lblPayload}}: {{item.payload || '--'}} | {{t.lblCity}}: {{item.city || '--'}}</view>
        
        <view class="info text-alert" wx:if="{{item.next_follow_up}}">
          ⏰ {{t.lblNextTime || (currentLang === 'zh' ? '约定跟进' : 'นัดหมาย')}}: {{item.next_follow_up}}
        </view>
        <view class="info text-gray" wx:else>
          ⏰ {{currentLang === 'zh' ? '首次分配' : 'เวลาที่ได้รับ'}}: {{item.formattedCreateTime || '--'}}
        </view>

      </view>
    </view>

    <view class="loading-bottom" wx:if="{{customerList.length > 0}}">
      <text>{{isLoading ? t.loading : (hasMore ? t.loadMore : t.noMore)}}</text>
    </view>
  </scroll-view>
</view>