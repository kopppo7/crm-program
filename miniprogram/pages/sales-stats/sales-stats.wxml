<view class="container">
  
  <view class="page-header">
    <view class="header-left">
      <text class="title">销售数据统计</text>
      <text class="subtitle">实时掌控团队执行力</text>
    </view>
    <view class="date-badge">
      <text class="icon">📅</text>
      <text>{{todayStr}}</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{activeStats.length === 0 && disabledStats.length === 0 && !isLoading}}">
    暂无销售数据
  </view>

  <view class="stats-list" wx:else>
    <view class="sales-card" wx:for="{{activeStats}}" wx:key="name">
      <view class="card-header">
        <view class="user-info">
          <view class="avatar">{{item.avatarText}}</view>
          <text class="sales-name">{{item.name}}</text>
          <view class="total-tag">总客户: {{item.totalCustomers}}</view>
        </view>
        <view class="rank-badge" wx:if="{{index === 0}}">🏆 勤奋之星</view>
      </view>

      <view class="data-grid">
        <view class="data-item">
          <text class="data-num highlight-blue">{{item.todayFollowUps}}</text>
          <text class="data-label">今日跟进</text>
        </view>
        <view class="data-item">
          <text class="data-num {{item.todayRemaining > 0 ? 'highlight-orange' : ''}}">{{item.todayRemaining}}</text>
          <text class="data-label">今日待办</text>
        </view>
        <view class="data-item">
          <text class="data-num">{{item.tomorrowFollowUps}}</text>
          <text class="data-label">明日跟进</text>
        </view>
        <view class="data-item">
          <text class="data-num {{item.overdueCount > 0 ? 'highlight-red' : ''}}">{{item.overdueCount}}</text>
          <text class="data-label">逾期待办</text>
        </view>
      </view>
    </view>

    <view class="disabled-toggle" wx:if="{{disabledStats.length > 0}}" bindtap="toggleDisabled">
      <text class="line"></text>
      <text class="toggle-text">{{showDisabled ? '收起' : '展开'}}已离职/禁用销售 ({{disabledStats.length}}人)</text>
      <text class="line"></text>
    </view>

    <view class="disabled-list" wx:if="{{showDisabled}}">
      <view class="sales-card disabled-card" wx:for="{{disabledStats}}" wx:key="name">
        <view class="card-header">
          <view class="user-info">
            <view class="avatar" style="background: #ccc;">{{item.avatarText}}</view>
            <text class="sales-name" style="color: #999;">{{item.name}} (已停用)</text>
            <view class="total-tag" style="background: #f5f5f5; color: #999;">总客户: {{item.totalCustomers}}</view>
          </view>
        </view>
        <view class="data-grid" style="opacity: 0.6;">
          <view class="data-item"><text class="data-num">{{item.todayFollowUps}}</text><text class="data-label">今日跟进</text></view>
          <view class="data-item"><text class="data-num">{{item.todayRemaining}}</text><text class="data-label">今日待办</text></view>
          <view class="data-item"><text class="data-num">{{item.tomorrowFollowUps}}</text><text class="data-label">明日跟进</text></view>
          <view class="data-item"><text class="data-num">{{item.overdueCount}}</text><text class="data-label">逾期待办</text></view>
        </view>
      </view>
    </view>

  </view>
</view>