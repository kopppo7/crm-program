page {
  background-color: #f5f7fa;
}

.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 顶部信息 */
.page-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #888;
}

.date-badge {
  background: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #07c160;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.empty-state {
  text-align: center;
  color: #999;
  margin-top: 200rpx;
  font-size: 28rpx;
}

/* 销售卡片 */
.stats-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.sales-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 20rpx;
  position: relative;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #07c160, #4ad28b);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.sales-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.rank-badge {
  position: absolute;
  right: 0;
  background: #fffbe6;
  color: #faad14;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

/* 数据网格 */
.data-grid {
  display: flex;
  justify-content: space-around;
}

.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.data-label {
  font-size: 24rpx;
  color: #888;
}

/* 高亮样式 */
.highlight-blue {
  color: #1890ff; /* 蓝色代表今日活跃动作 */
}

.highlight-red {
  color: #ff4d4f; /* 红色代表危险/逾期待办 */
}