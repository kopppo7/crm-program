<view class="container">
  <view wx:if="{{logs.length === 0 && !isLoading}}" class="empty-state">
    暂无分配记录 / ไม่มีประวัติการมอบหมาย
  </view>

  <view class="log-list" wx:else>
    <view class="log-card" wx:for="{{logs}}" wx:key="_id" bindtap="goToDetail" data-cid="{{item.customer_id}}">
      <view class="log-header">
        <text class="log-time">{{item.timeStr}}</text>
        <text class="arrow">详情 ></text> 
      </view>
      <view class="log-body">
        <text class="log-note">{{item.note}}</text>
      </view>
    </view>
  </view>
</view>