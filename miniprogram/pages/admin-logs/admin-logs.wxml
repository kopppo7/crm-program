<view class="container">
<!-- 🌟 全新美化：顶部人员选择区域 -->
<view class="filter-section">
    <view class="filter-header">
      <text class="filter-title">📋 动态跟进</text>
      
      <picker mode="selector" range="{{userList}}" range-key="name" bindchange="onUserChange">
        <view class="picker-btn">
          <text class="user-name">{{userList[selectedIndex].name}}</text>
          <text class="arrow-down"></text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 下方：原有的日志列表区域 -->
  <view wx:if="{{logs.length === 0 && !isLoading}}" class="empty-state">
    暂无操作记录 / ไม่มีประวัติการทำงาน
  </view>

  <view class="log-list" wx:else>
    <view class="log-card" wx:for="{{logs}}" wx:key="_id" bindtap="goToDetail" data-cid="{{item.customer_id}}">
      <view class="log-header">
        <text class="log-time">{{item.timeStr}}</text>
        <text class="arrow">详情 ></text> 
      </view>
      <view class="log-body">
        <text class="log-note">{{item.note}}</text>
      </view>
    </view>
  </view>
</view>