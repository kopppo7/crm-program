page {
  background-color: #f5f7fa;
}
.container {
  padding: 20rpx;
  min-height: 100vh;
}
.empty-state {
  text-align: center;
  color: #999;
  margin-top: 150rpx;
  font-size: 28rpx;
}

.log-list {
  padding-bottom: 40rpx;
}

.log-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.log-card:active {
  background: #fcfcfc;
}

.log-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 2rpx dashed #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}
.arrow {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.log-body {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.log-note {
  color: #e6a23c;
  font-weight: 500;
}