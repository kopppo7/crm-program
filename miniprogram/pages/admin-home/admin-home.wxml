<view class="work-station"> 
  <view class="lang-switch-bar">
    <view class="lang-btn" bindtap="switchLang">
      <text class="icon">🌐</text>
      <text>{{currentLang === 'zh' ? 'เปลี่ยนเป็นภาษาไทย' : '切换为中文'}}</text>
    </view>
  </view>

  <view class="header">
    <text class="title">{{t.adminTitle}}</text>
  </view>

  <view class="menu-list">
    <view class="menu-card" bindtap="goToDistribute">
      <view class="card-left">
        <view class="icon-box" style="background: #e6f7ff;">📋</view>
        <view class="card-text">
          <text class="card-name">{{t.adminDistribute}}</text>
          <text class="card-desc">{{t.adminDistributeDesc}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="menu-card" bindtap="goToCustomerView">
      <view class="card-left">
        <view class="icon-box" style="background: #f6ffed;">👥</view>
        <view class="card-text">
          <text class="card-name">{{t.adminView}}</text>
          <text class="card-desc">{{t.adminViewDesc}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="menu-card" bindtap="goToMemberMgmt" wx:if="{{userRole === 'admin'}}">
      <view class="card-left">
        <view class="icon-box" style="background: #fff0f6;">⚙️</view>
        <view class="card-text">
          <text class="card-name">{{t.adminMember}}</text>
          <text class="card-desc">{{t.adminMemberDesc}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="menu-card" bindtap="goToAdminLogs" wx:if="{{userRole === 'admin'}}">
      <view class="card-left">
        <view class="icon-box" style="background: #fffbe6;">🕒</view>
        <view class="card-text">
          <text class="card-name">{{t.adminLog}}</text>
          <text class="card-desc">{{t.adminLogDesc}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="menu-card" bindtap="goToDailyStats" wx:if="{{userRole === 'admin'}}">
      <view class="card-left">
        <view class="icon-box" style="background: #f9f0ff;">📈</view>
        <view class="card-text">
          <text class="card-name">{{t.adminStats}}</text>
          <text class="card-desc">{{t.adminStatsDesc}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="menu-card" bindtap="goToWorkReports" wx:if="{{userRole === 'admin' || userRole === 'manager'}}">
      <view class="card-left">
        <view class="icon-box" style="background: #f0f9eb;">📊</view>
        <view class="card-text">
          <text class="card-name">{{currentLang === 'zh' ? '团队工作汇报' : 'รายงานการทำงานของทีม'}}</text>
          <text class="card-desc">{{currentLang === 'zh' ? '查阅销售周计划与每日工作汇报' : 'ดูแผนงานและรายงานประจำวันของฝ่ายขาย'}}</text>
        </view>
      </view>
      <text class="card-arrow">></text>
    </view>

  </view>
</view>