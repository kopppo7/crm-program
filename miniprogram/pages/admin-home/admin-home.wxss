page {
  background-color: #f5f7fa;
}
.work-station {
  padding: 20px;
}
.header {
  margin-bottom: 30px;
}
.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
}
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
}
.menu-card {
  width: 45%;
  background: #ffffff;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}
.menu-card:active {
  background: #f0f0f0;
}
.icon-box {
  font-size: 32px;
  margin-bottom: 10px;
}
.card-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}
.card-desc {
  font-size: 12px;
  color: #888;
}
