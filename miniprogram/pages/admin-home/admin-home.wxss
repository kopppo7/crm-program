page {
  background-color: #f5f7fa;
}

.work-station {
  padding: 40rpx;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

/* 改为垂直方向排列 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx; 
}

/* 单个卡片样式：横向拉通，两端对齐 */
.menu-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s ease;
}

.menu-card:active {
  background: #f8f8f8;
  transform: scale(0.98);
}

.card-left {
  display: flex;
  align-items: center;
}

/* 图标的独立背景和圆角 */
.icon-box {
  font-size: 48rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.card-text {
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #888;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}
/* ==========================================
   🌟 新增：管理后台多语言切换栏样式 
   ========================================== */
   .lang-switch-bar {
    display: flex;
    justify-content: flex-end; /* 让语言切换按钮整体靠右对齐 */
    padding: 20rpx 30rpx 10rpx 30rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .lang-btn {
    display: flex;
    align-items: center;
    background-color: #f1f5f9; /* 浅灰色背景，低调不抢主视觉 */
    padding: 12rpx 24rpx;
    border-radius: 30rpx; /* 圆角胶囊形状 */
    font-size: 24rpx;
    color: #334155;
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05); /* 淡淡的阴影增加质感 */
  }
  
  .lang-btn .icon {
    margin-right: 8rpx; /* 地球图标和文字之间的间距 */
    font-size: 26rpx;
  }
  
  /* 激活点击反馈效果 */
  .lang-btn:active {
    opacity: 0.7;
  }