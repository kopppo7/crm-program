page { background-color: #f5f7fa; }
.container { padding: 15px; padding-bottom: 40px; }
.card { width: 90%; background: #fff; border-radius: 12px; padding: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.card-title { font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333; border-left: 4px solid #07c160; padding-left: 8px;}

.form-item { display: flex; align-items: center; padding: 12px 0; border-bottom: 1px solid #f0f0f0; }
.form-item.column { flex-direction: column; align-items: flex-start; border-bottom: none; }
.label { width: 80px; font-size: 14px; color: #555; margin-bottom: 8px; font-weight: 500; }
.text-danger { color: #ff4d4f; }
.picker-val { flex: 1; font-size: 15px; color: #07c160; font-weight: 500; }
.input-box { width: 100%; height: 40px; background: #f9f9f9; padding: 0 10px; border-radius: 8px; font-size: 14px; box-sizing: border-box; }
.note-input { width: 100%; height: 80px; background: #f9f9f9; padding: 10px; border-radius: 8px; box-sizing: border-box; font-size: 14px; }

/* 多图上传网格样式 */
.image-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 5px; width: 100%; }
.img-box { width: 80px; height: 80px; position: relative; border-radius: 8px; overflow: hidden; }
.preview-img { width: 100%; height: 100%; }
.del-btn { position: absolute; top: 0; right: 0; background: rgba(0,0,0,0.5); color: #fff; width: 20px; height: 20px; line-height: 18px; text-align: center; border-bottom-left-radius: 8px; font-size: 16px; }
.upload-btn { width: 80px; height: 80px; background: #f0f2f5; border: 1px dashed #ccc; border-radius: 8px; display: flex; justify-content: center; align-items: center; }
.plus { font-size: 30px; color: #999; margin-bottom: 4px; }

.submit-btn { background: #07c160; color: #fff; margin-top: 20px; border-radius: 8px; font-weight: bold;}

/* --- 音频上传样式 --- */
.audio-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 10rpx;
}

.audio-box {
  display: flex;
  align-items: center;
  background-color: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  position: relative;
  border: 1px solid #e9ecef;
}

.audio-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.audio-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 40rpx;
}

.audio-del {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  background-color: #ff4d4f;
  color: #fff;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 28rpx;
  font-size: 24rpx;
  z-index: 10;
}
.tag-busy {
  background: #e0e7ff; 
  color: #4f46e5; /* 优雅的靛蓝色，区分于未接的警告黄 */
}

/* 🌟 客户画像高级卡片样式 */
.profile-card {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); /* 柔和的高级阴影 */
  overflow: hidden;
  padding: 0; /* 覆写默认 padding，让 header 顶边充满 */
  width: 100%;
}

/* 顶部标题栏 */
.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8fafc; /* 淡灰蓝色背景 */
  border-bottom: 2rpx solid #f1f5f9;
}

.profile-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #3b82f6; /* 主题蓝 */
  display: flex;
  align-items: center;
}

.profile-title .icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

/* 折叠箭头动画 */
.collapse-arrow {
  color: #94a3b8;
  font-size: 30rpx;
  font-family: monospace;
  transition: transform 0.3s ease;
}
.collapse-arrow.expanded {
  transform: rotate(90deg);
}

/* 身体表单区 */
.profile-body {
  padding: 30rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.p-input-group {
  margin-bottom: 26rpx;
}
.p-input-group:last-child {
  margin-bottom: 0;
}

.p-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.p-input {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 10rpx;
  /* padding: 18rpx 24rpx; */
  font-size: 28rpx;
  color: #1e293b;
  transition: all 0.2s ease;
}

/* 交互反馈：输入框聚焦时变蓝变白 */
.p-input:focus {
  border-color: #3b82f6;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

.p-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}