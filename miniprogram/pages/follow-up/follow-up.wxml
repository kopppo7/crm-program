<view class="container">
  <view class="card">
    <!-- 🌟 头部与重点客户标记 (自带反显能力) -->
    <view class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
      <text>{{t.fuTitle}}</text>
      <view class="key-customer-toggle" style="display: flex; align-items: center;">
        <text style="font-size: 26rpx; margin-right: 10rpx; color: {{isKeyCustomer ? '#f59e0b' : '#999'}};">{{currentLang === 'zh' ? '⭐ 重点客户' : '⭐ ลูกค้าสำคัญ'}}</text>
        <switch checked="{{isKeyCustomer}}" bindchange="onKeyCustomerChange" color="#f59e0b" style="transform:scale(0.7); margin: 0;"/>
      </view>
    </view>

    <!-- 🌟 重点原因 (开启重点客户时显示，自带反显) -->
    <view class="form-item column" wx:if="{{isKeyCustomer}}">
      <text class="label" style="color: #f59e0b;">{{currentLang === 'zh' ? '重点原因' : 'เหตุผลสำคัญ'}}</text>
      <input class="input-box" placeholder="{{currentLang === 'zh' ? '请输入将此客户标记为重点的原因...' : 'โปรดระบุเหตุผลที่ให้ความสำคัญ...'}}" value="{{keyCustomerReason}}" bindinput="onKeyReasonInput" />
    </view>

    <!-- 跟进结果 -->
    <view class="form-item">
      <text class="label">{{t.fuResult}}</text>
      <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
        <view class="picker-val {{!selectedStatusLabel ? 'text-gray' : ''}}">{{selectedStatusLabel || t.fuResultPlaceholder}}</view>
      </picker>
    </view>

    <!-- 🌟 沟通方式 (已成交、未接电话、不方便接电话 时隐藏) -->
    <view class="form-item" wx:if="{{selectedStatus !== 'Closed Won' && selectedStatus !== 'No Answer' && selectedStatus !== 'Busy' && selectedStatus !== 'Invalid'}}">
      <text class="label">{{t.fuType}}</text>
      <picker mode="selector" range="{{followTypes}}" bindchange="onTypeChange">
        <view class="picker-val">{{selectedType || t.fuTypePlaceholder}}</view>
      </picker>
    </view>

    <!-- 动态字段 (已成交 -> 成交金额) -->
    <view class="form-item column" wx:if="{{selectedStatus === 'Closed Won'}}">
      <text class="label">{{currentLang === 'zh' ? '💰 成交金额' : '💰 ยอดซื้อขาย'}}</text>
      <input class="input-box" type="digit" placeholder="{{currentLang === 'zh' ? '请输入最终成交金额' : 'โปรดระบุยอดเงินสุทธิ'}}" value="{{transactionAmount}}" bindinput="onAmountInput" />
    </view>

    <!-- 无效线索防误触提示 -->
    <view class="form-item column" wx:if="{{selectedStatus === 'Invalid'}}" style="padding: 10rpx 0;">
      <view style="background: #fee2e2; padding: 20rpx; border-radius: 8rpx;">
        <text style="color: #ef4444; font-size: 24rpx; line-height: 1.5;">{{currentLang === 'zh' ? '⚠️ 提示：此选项仅适用于【错号、空号】。若为多次未接，系统会自动判定并归类，无需手动选择。' : '⚠️ คำแนะนำ: เลือกเฉพาะเบอร์ผิด/ไม่มีหมายเลขนี้ หากไม่รับสายหลายครั้งระบบจะจัดประเภทให้อัตโนมัติ'}}</text>
      </view>
    </view>

    <!-- 下次跟进时间 (未接电话、流失、成交、无效时均隐藏) -->
    <view class="form-item" wx:if="{{selectedStatus !== 'Closed Won' && selectedStatus !== 'Closed Lost' && selectedStatus !== 'Invalid' && selectedStatus !== 'No Answer'}}">
      <text class="label">{{t.fuNextTime}}</text>
      <picker mode="date" start="{{today}}" value="{{nextFollowUp || today}}" bindchange="onDateChange">
        <view class="picker-val {{!nextFollowUp ? 'text-gray' : ''}}">{{nextFollowUp || t.fuDatePlaceholder}}</view>
      </picker>
    </view>

    <!-- 🌟 简述说明 (无效线索时彻底隐藏；“还在考虑”时动态改变 placeholder) -->
    <view class="form-item column" wx:if="{{selectedStatus !== 'Invalid' && (selectedStatus !== 'No Answer' || todayNoAnswerCount >= 1)}}">
      <text class="label">{{t.fuNote}}</text>
      <textarea class="note-input" placeholder="{{selectedStatus === 'Considering' ? (currentLang === 'zh' ? '请记录：客户还在考虑什么？' : 'โปรดระบุ: ลูกค้ายังพิจารณาเรื่องอะไร?') : t.fuNotePlaceholder}}" bindinput="onNoteInput" value="{{note}}"></textarea>
    </view>

    <!-- 🌟 图片上传 (无效线索时彻底隐藏) -->
    <view class="form-item column" wx:if="{{selectedStatus !== 'Invalid' && (selectedStatus !== 'No Answer' || todayNoAnswerCount >= 1)}}">
      <view style="width: 100%;">
        <text wx:if="{{selectedStatus === 'No Answer' && todayNoAnswerCount >= 1}}" style="color: #e74c3c; font-size: 24rpx; font-weight: bold;">* </text>
        <text class="label">{{selectedStatus === 'Closed Won' ? (currentLang === 'zh' ? '💳 上传客户支付凭证截图' : '💳 อัปโหลดหลักฐานการชำระเงิน') : t.fuUpload}}</text>
      </view>
      <view class="image-grid">
        <view class="img-box" wx:for="{{tempImgPaths}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="preview-img" bindtap="previewImage" data-url="{{item}}"></image>
          <view class="del-btn" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="chooseImage" wx:if="{{tempImgPaths.length < 3}}">
          <text class="plus">+</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="card profile-card">
    <view class="profile-header" bindtap="toggleProfile">
      <view class="profile-title">
        <text class="icon">🎯</text>
        <text>{{currentLang === 'zh' ? '完善客户画像 (选填)' : 'ข้อมูลลูกค้า (เลือกกรอก)'}}</text>
      </view>
      <text class="collapse-arrow {{isProfileExpanded ? 'expanded' : ''}}">></text>
    </view>

    <!-- 🌟 客户画像 (自带反显能力) -->
    <view class="profile-body" wx:if="{{isProfileExpanded}}">
      <view class="p-input-group">
        <text class="p-label">{{t.profileDemand || (currentLang === 'zh' ? '核心需求' : 'ความต้องการ')}}</text>
        <input class="p-input" value="{{profile.demand}}" data-field="demand" bindinput="onProfileInput" placeholder="{{currentLang === 'zh' ? '例: 需要10吨载重' : 'เช่น: ต้องการน้ำหนักบรรทุก 10 ตัน'}}" placeholder-class="p-placeholder" />
      </view>
      <view class="p-input-group">
        <text class="p-label">{{t.profileMotivation || (currentLang === 'zh' ? '购买动机' : 'แรงจูงใจ')}}</text>
        <input class="p-input" value="{{profile.motivation}}" data-field="motivation" bindinput="onProfileInput" placeholder="{{currentLang === 'zh' ? '例: 扩大业务规模' : 'เช่น: ขยายธุรกิจ'}}" placeholder-class="p-placeholder" />
      </view>
      <view class="p-input-group">
        <text class="p-label">{{t.profileUserType || (currentLang === 'zh' ? '最终使用者' : 'ผู้ใช้งาน')}}</text>
        <input class="p-input" value="{{profile.userType}}" data-field="userType" bindinput="onProfileInput" placeholder="{{currentLang === 'zh' ? '例: 农场工人' : 'เช่น: คนงานในฟาร์ม'}}" placeholder-class="p-placeholder" />
      </view>
      <view class="p-input-group">
        <text class="p-label">{{t.profileScenario || (currentLang === 'zh' ? '使用场景' : 'สถานที่ใช้งาน')}}</text>
        <input class="p-input" value="{{profile.scenario}}" data-field="scenario" bindinput="onProfileInput" placeholder="{{currentLang === 'zh' ? '例: 泥泞道路' : 'เช่น: ถนนโคลน'}}" placeholder-class="p-placeholder" />
      </view>
      <view class="p-input-group">
        <text class="p-label">{{t.profileTimeframe || (currentLang === 'zh' ? '预计购买时间' : 'เวลาที่คาดว่าจะซื้อ')}}</text>
        <input class="p-input" value="{{profile.timeframe}}" data-field="timeframe" bindinput="onProfileInput" placeholder="{{currentLang === 'zh' ? '例: 下个月' : 'เช่น: เดือนหน้า'}}" placeholder-class="p-placeholder" />
      </view>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitFollowUp">{{t.fuSubmit}}</button>
</view>