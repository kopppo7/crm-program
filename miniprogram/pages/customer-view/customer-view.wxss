/* =========================================
   全局与容器结构
   ========================================= */
   page { 
    background-color: #f4f6f9; 
    height: 100%; 
    overflow: hidden; 
  }
  
  .container { 
    display: flex; 
    flex-direction: column; 
    height: 100vh; 
  }
  
  /* =========================================
     搜索与筛选区
     ========================================= */
  .search-bar { 
    background: #fff; 
    padding: 16rpx 30rpx; /* 减小上下高度 */
    border-bottom: 1rpx solid #eee; 
    position: sticky; 
    top: 0; 
    z-index: 10; 
  }
  
  .search-box { 
    display: flex; 
    align-items: center; 
    background: #f0f2f5; 
    border-radius: 40rpx; 
    padding: 0 30rpx; 
    height: 64rpx; /* 搜索框变扁 */
    width: 100%; 
    box-sizing: border-box; 
  }
  
  .search-input { 
    flex: 1; 
    margin-left: 16rpx; 
    font-size: 26rpx; 
    color: #333; 
  }
  
  /* =========================================
     列表区域
     ========================================= */
  .list-container { 
    flex: 1; 
    height: 0; 
    padding: 24rpx 30rpx; 
    box-sizing: border-box; 
  }
  
  .empty-state { 
    text-align: center; 
    color: #999; 
    margin-top: 160rpx; 
    font-size: 28rpx; 
  }
  
  /* =========================================
     卡片主体 (极致高度压缩、清爽设计)
     ========================================= */
  .customer-card { 
    background: #fff; 
    border-radius: 16rpx; 
    margin-bottom: 24rpx; 
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02); 
    display: flex; 
    flex-direction: column; 
    overflow: hidden; 
  }
  
  .card-content { 
    padding: 24rpx; /* 内边距缩小，让卡片更紧凑 */
    position: relative;
  }
  
  /* 1. 头部容器 */
  .header {
    display: flex;
    align-items: flex-start;
    width: 100%;
    margin-bottom: 8rpx;
  }
  
  .name-box {
    display: flex;
    align-items: center;
    flex: 1;
    padding-right: 140rpx; /* 给右上角标签留出安全区 */
  }
  
  .key-star {
    margin-right: 8rpx;
    font-size: 26rpx;
  }
  
  /* 名字限制单行缩略 */
  .name {
    font-size: 32rpx;
    font-weight: 800;
    color: #1f2937;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* 2. 电话行突出显示 */
  .phone-row {
    margin-bottom: 12rpx;
  }
  
  .phone-link {
    color: #10b981; 
    font-size: 30rpx;
    font-weight: bold;
    text-decoration: underline;
    padding: 4rpx 0; 
    display: inline-block;
  }
  
  /* 3. 辅助信息强制单行，自动截断防撑破卡片 */
  .info.text-gray { 
    color: #6b7280; 
    font-size: 24rpx; 
    margin-bottom: 16rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* 🌟 4. 全新底部极简元数据栏 (替代以前的 footer-info) */
  .card-bottom-bar {
    display: flex;
    flex-wrap: wrap; /* 横向排列，自动折行 */
    background: #f8fafc; /* 超级淡的背景块，代替线条分割 */
    padding: 10rpx 16rpx;
    border-radius: 8rpx;
    column-gap: 24rpx;
    row-gap: 8rpx;
  }
  
  .bottom-item {
    font-size: 22rpx;
    color: #64748b;
    display: flex;
    align-items: center;
  }
  
  .bottom-icon {
    margin-right: 6rpx;
    font-size: 22rpx;
  }
  
  .text-highlight {
    color: #f59e0b; /* 橙色高亮约定时间 */
    font-weight: bold;
  }
  
  /* =========================================
     状态标签体系 (右上角绝对定位)
     ========================================= */
  .tags-container {
    position: absolute; 
    top: 24rpx; 
    right: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8rpx;
    z-index: 2; 
  }
  
  .tag {
    padding: 4rpx 14rpx;
    border-radius: 8rpx;
    font-size: 20rpx;
    font-weight: bold;
  }
  
  .tag-overdue { background-color: #fee2e2; color: #ef4444; }
  .tag-pending { background-color: #e0f2fe; color: #0284c7; }
  .tag-warning { background-color: #fef3c7; color: #d97706; }
  .tag-following { background-color: #f3e8ff; color: #7e22ce; }
  .tag-closed { background-color: #f1f5f9; color: #64748b; font-weight: normal; }
  
  /* =========================================
     Tabs 样式
     ========================================= */
  .todo-tabs {
    width: 100%;
    display: flex;
    background-color: #fff;
    border-bottom: 2rpx solid #f1f2f6;
    padding: 0 40rpx;
    position: relative;
    z-index: 10;
  }
  
  .todo-tab {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    padding: 24rpx 0;
    position: relative;
    transition: all 0.3s;
  }
  
  .todo-tab.active {
    color: #10b981; 
    font-weight: bold;
  }
  
  .todo-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 50rpx;
    height: 6rpx;
    background-color: #10b981;
    border-radius: 6rpx;
  }
  
  .loading-bottom { 
    text-align: center; 
    padding: 20rpx 0 40rpx; 
    font-size: 24rpx; 
    color: #aaa; 
  }