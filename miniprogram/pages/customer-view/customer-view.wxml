<view class="container">
  <view class="search-bar">
    <view class="search-box">
      <icon type="search" size="14" color="#999" />
      <input 
        class="search-input" 
        placeholder="搜索姓名、电话、城市、载重、购买时间..." 
        bindinput="onSearchInput" 
        bindconfirm="onSearch" 
        confirm-type="search" 
        value="{{searchKeyword}}"
      />
      <icon wx:if="{{searchKeyword}}" type="clear" size="14" color="#ccc" bindtap="clearSearch" style="padding: 10px;" />
    </view>
  </view>

  <view class="filter-bar">
    <picker class="filter-picker" mode="selector" range="{{salesOptions}}" range-key="name" bindchange="onSalesChange">
      <view class="filter-item">
        <text>{{salesOptions[selectedSalesIndex].name}}</text>
        <text class="arrow">▾</text>
      </view>
    </picker>
    
    <picker class="filter-picker" mode="selector" range="{{statusFilterOptions}}" range-key="label" bindchange="onStatusFilterChange">
      <view class="filter-item">
        <text>{{statusFilterOptions[selectedStatusIndex].label}}</text>
        <text class="arrow">▾</text>
      </view>
    </picker>
  </view>

  <scroll-view class="list-container" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{customerList.length === 0 && !isLoading}}" class="empty-state">
      <text>暂无符合条件的客户数据</text>
    </view>

    <view class="customer-card" wx:for="{{customerList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="card-content">
        <view class="header">
          <text class="name">{{item.name}}</text>
          <text class="tag status-{{item.status}}">{{statusMap[item.status] || item.status || '待处理'}}</text>
        </view>
        <view class="info">📞 {{item.phone}}</view>
        <view class="info text-gray">城市: {{item.city || '--'}} | 需求: {{item.payload || '--'}}</view>
        <view class="info text-gray" wx:if="{{item.timeline}}">预计购买: {{item.timeline}}</view>
        
        <view class="divider"></view>
        
        <view class="footer-info">
          <text class="sales-name">👤 负责人: {{item.assigned_sales_name || '未分配'}}</text>
          <text class="next-time" wx:if="{{item.next_follow_up}}">⏰ 下次跟进: {{item.next_follow_up}}</text>
        </view>
      </view>
    </view>

    <view class="loading-bottom" wx:if="{{customerList.length > 0}}">
      <text>{{isLoading ? '加载中...' : (hasMore ? '上拉加载更多' : '— 到底啦 —')}}</text>
    </view>
  </scroll-view>
</view>
