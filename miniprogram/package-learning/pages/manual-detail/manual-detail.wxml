<view class="container">
  <view class="tips">
    <text>💡 {{t.manualDetailTips || (currentLang === 'zh' ? '建议点击图片放大查看高清细节' : 'แนะนำให้คลิกที่รูปภาพเพื่อขยายดูรายละเอียด')}}</text>
  </view>
  
  <view class="image-list">
    <image 
      wx:for="{{images}}" 
      wx:key="*this" 
      src="{{item}}" 
      mode="widthFix" 
      class="product-img" 
      lazy-load="true"
      bindtap="previewImage" 
      data-src="{{item}}"
    ></image>
  </view>

  <view class="footer-safe-area"></view>
</view>