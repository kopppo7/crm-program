<view class="page-container">
  
  <!-- 1. 高级感沉浸式头部 -->
  <view class="header-bg">
    <view class="header-content">
      <view class="title-box">
        <text class="title">{{t.manualHeader}}</text>
        <text class="subtitle">{{t.manualSub}}</text>
      </view>
      <view class="security-tag">
        <text class="tag-icon">🔒</text> {{t.manualTag}}
      </view>
    </view>
  </view>

  <!-- 2. 悬浮列表区 -->
  <view class="list-container">
    <view 
      class="module-card" 
      wx:for="{{moduleList}}" 
      wx:key="id" 
      bindtap="goToDetail" 
      data-id="{{item.id}}" 
    >
      
      <view class="info-wrap">
        <view class="title-row">
          <text class="title-zh">{{item.titleMain}}</text>
        </view>
        <text class="desc">{{item.desc}}</text>
      </view>

      <view class="arrow-wrap">
        <text class="arrow"></text>
      </view>

    </view>
  </view>

</view>