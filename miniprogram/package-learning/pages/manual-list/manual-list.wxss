page {
  background-color: #f4f6f9; /* 极简的浅灰背景色 */
}

/* ================= 头部背景 ================= */
.header-bg {
  width: 100%;
  height: 380rpx;
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  position: relative;
  z-index: 1;
}

.header-content {
  padding: 60rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title-box {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #94a3b8;
  letter-spacing: 1rpx;
}

.security-tag {
  background: rgba(239, 68, 68, 0.15);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  color: #fca5a5;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.tag-icon {
  margin-right: 6rpx;
  font-size: 20rpx;
}

/* ================= 悬浮列表 ================= */
.list-container {
  margin-top: -120rpx; /* 负边距，让列表悬浮在深色背景上 */
  padding: 0 30rpx;
  position: relative;
  z-index: 2;
  padding-bottom: 60rpx;
}

.module-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.04); /* 极度柔和的大厂阴影 */
  transition: all 0.2s ease;
}

.module-card:active {
  transform: scale(0.98); /* 点击时的微缩回弹动效 */
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.03);
}

/* 图标区 */
.icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.icon {
  font-size: 50rpx;
}

/* 文本区 */
.info-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title-row {
  display: flex;
  align-items: center;
}

.title-zh {
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.title-th {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
}

/* 箭头 */
.arrow-wrap {
  margin-left: 20rpx;
}

.arrow {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #cbd5e1;
  border-right: 4rpx solid #cbd5e1;
  transform: rotate(45deg); /* 用纯 CSS 画的简约现代小箭头 */
}